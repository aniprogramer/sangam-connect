# API base URL (defaults to http://localhost:8002 in dev)
VITE_API_URL=http://localhost:8002

# LiveKit adaptive media (adaptiveStream, dynacast, simulcast layers, Opus DTX/RED).
# Values live in packages/shared/src/roomOptions.js and are shared with mobile.
# Set to "false" to fall back to the LiveKit SDK defaults.
VITE_ADAPTIVE_MEDIA=true
