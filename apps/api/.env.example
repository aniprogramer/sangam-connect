# ==============================================================================
# Sangam Connect - Environment Variables Template
# ==============================================================================

# Server & Network Configuration
PORT=8002
NODE_ENV=development
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (Required - Never commit real credentials to source control)
DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/sangam?retryWrites=true&w=majority

# JWT Authentication Secrets (Required - each must be at least 32 characters)
# Generate securely with: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_access_key_min_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_long

# LiveKit SFU Configuration
# Key/secret must match the `keys:` entry in livekit.yaml, or webhook signatures
# and live permission updates (promote/demote) fail.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880

# Room Management
ROOM_GRACE_PERIOD_MS=900000
# Joiners default to "attendee" (listen-only) once a room has this many participants.
# Below it everyone joins as "speaker" (camera/mic allowed), same as before.
LARGE_ROOM_THRESHOLD=50
# Token requests beyond this many participants get 403 ROOM_FULL (the host is always admitted).
MAX_PARTICIPANTS=500

# SMTP / Email Verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM="Sangam Connect" <no-reply@sangam.connect>

# Production Reverse Proxy
# If running behind 1 reverse proxy (e.g. Nginx, Cloudflare), Express uses app.set("trust proxy", 1)
